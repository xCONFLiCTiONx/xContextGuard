<Window x:Class="xContextGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="xContextGuard" Height="640" Width="1140" MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Icon="icons/icon.ico"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="16" Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="icons/icon.ico" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="xContextGuard" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Inspect and manage context menus, startup programs, installed apps, and the Win+X menu" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ThemeToggleButton" Content="☀️ Light mode" Click="ThemeToggle_Click" Margin="0,0,10,0"/>
                <Button Content="⚡ Restart Explorer" ToolTip="Restart Windows Explorer to apply Win+X changes" Click="RestartExplorer_Click" Margin="0,0,10,0"/>
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Local system" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" ToolTip="Search names, commands, and locations" TextChanged="SearchBox_TextChanged" Margin="0,0,10,0"/>
                <ComboBox x:Name="LocationFilter" Grid.Column="1" SelectionChanged="LocationFilter_SelectionChanged" Margin="0,0,10,0" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="All locations" IsSelected="True"/>
                    <ComboBoxItem Content="Installed applications"/>
                    <ComboBoxItem Content="Installed apps (Missing files)"/>
                    <ComboBoxItem Content="Startup items (All)"/>
                    <ComboBoxItem Content="Startup (Registry)"/>
                    <ComboBoxItem Content="Startup (Folders)"/>
                    <ComboBoxItem Content="Win+X menu"/>
                    <ComboBoxItem Content="File context menu"/>
                    <ComboBoxItem Content="Folder context menu"/>
                    <ComboBoxItem Content="Folder background"/>
                    <ComboBoxItem Content="Drive context menu"/>
                    <ComboBoxItem Content="Desktop background"/>
                </ComboBox>
                <Button Grid.Column="2" Content="↻  Scan again" Click="Refresh_Click" Margin="0"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="0">
            <DataGrid x:Name="EntriesGrid" SelectionMode="Single" SelectionUnit="FullRow" AlternationCount="2" BorderThickness="0" Background="Transparent" MouseDoubleClick="EntriesGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Menu location" Binding="{Binding Location}" Width="2*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="130"/>
                    <DataGridTemplateColumn Header="Status" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDisabled}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource StatusEnabledBgBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource StatusDisabledBgBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDisabled}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusEnabledTextBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusDisabledTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Command / Target" Binding="{Binding Command}" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Ready to scan." Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Changes are backed up before they are applied." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Edit" Click="Edit_Click" Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="Backup" Click="Backup_Click"/>
                <Button Content="Restore backup" Click="Restore_Click"/>
                <Button Content="Enable" Click="Enable_Click"/>
                <Button Content="Disable" Click="Disable_Click"/>
                <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" Style="{StaticResource DangerButtonStyle}" Margin="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
